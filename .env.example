# Copia a .env y llena los valores. Nunca subas .env al repo.
PORT=3000

# Postgres
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=minimundo
# true borra todas las tablas al arrancar (solo desarrollo)
DROP_SCHEMA=false

# S3
AWS_ACCESS_KEY=
AWS_SECRET_KEY=
AWS_REGION=us-east-1
AWS_S3_NAME=

# WhatsApp Cloud API (Meta)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
# Token que tú eliges y pegas en Meta al configurar el webhook
WHATSAPP_VERIFY_TOKEN=
# App secret de la app de Meta: valida X-Hub-Signature-256
WHATSAPP_APP_SECRET=

# Gemini (ADK lee GEMINI_API_KEY directamente)
GEMINI_API_KEY=
GEMINI_MODEL=

# Ventana de agrupación de mensajes en ms (default 7000)
BATCH_QUIET_MS=

# Auth (JWT). Obligatoria: sin ella la app no arranca.
JWT_SECRET=
# Admin inicial (rol Administrador). Si falta alguna, no se crea.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
